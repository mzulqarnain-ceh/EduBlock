# EduBlock Backend Environment Variables

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edublock

# JWT Authentication
SECRET_KEY=edublock-super-secret-key-change-in-production-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Blockchain
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# IPFS (Pinata)
PINATA_API_KEY=
PINATA_SECRET_KEY=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# App
APP_NAME=EduBlock
APP_VERSION=1.0.0
FRONTEND_URL=http://localhost:5173
